# ---- Required ----
# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Any long random text (at least 32 characters). Keeps host sign-ins secure.
SESSION_SECRET=
# Your public web address, e.g. https://weparty.vercel.app (used in QR codes)
NEXT_PUBLIC_APP_URL=

# ---- Live updates (strongly recommended) ----
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Optional: only people with this code can create host accounts ----
HOST_SIGNUP_CODE=

# ---- Apple Music (optional until your Apple Developer account is ready) ----
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the whole .p8 file contents; newlines can be written as \n
APPLE_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us

# ---- Payments (all OFF by default; Stripe TEST keys only: sk_test_..., pk_test_...) ----
# Turn features on with "1". Leave blank or 0 to keep them hidden.
FEATURE_PAYMENTS=
FEATURE_PLANS=
FEATURE_SPONSOR=
# Keep OFF: hides payment buttons inside the iPhone/Android apps (see docs/PAYMENTS.md)
PAYMENTS_IN_NATIVE_APP=
# Stripe > Developers > API keys (test mode). Live keys are refused unless STRIPE_ALLOW_LIVE=1.
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > your endpoint (https://YOUR-SITE/api/stripe/webhook) > Signing secret
STRIPE_WEBHOOK_SECRET=
# STRIPE_ALLOW_LIVE=1
# We Party's cut of tips and boosts, in percent (default 10)
PLATFORM_FEE_PERCENT=10
# Boost and tip buttons, in cents
BOOST_PRICES_CENTS=100,300,500
TIP_AMOUNTS_CENTS=300,500,1000,2000
# Plan prices in cents (placeholders until you decide)
PRICE_DJ_PRO_CENTS=1900
PRICE_EVENT_PASS_CENTS=4900
PRICE_VENUE_CENTS=9900

# ---- Testing only. Never set this in production. ----
# WEPARTY_TEST_CATALOG=1
