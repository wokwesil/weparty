# ---- Required ----
# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Any long random text (at least 32 characters). Keeps host sign-ins secure.
SESSION_SECRET=
# Your public web address, e.g. https://weparty.vercel.app (used in QR codes)
NEXT_PUBLIC_APP_URL=

# ---- Live updates (strongly recommended) ----
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Optional: only people with this code can create host accounts ----
HOST_SIGNUP_CODE=

# ---- Email for "Forgot password?" (see docs/PASSWORD_RESET.md) ----
# Easiest (free, no domain needed): a Gmail account + a Google "app password".
# Google Account > Security > 2-Step Verification (turn on) > App passwords > create one.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Name shown on the email (optional, default "We Party")
EMAIL_FROM_NAME=
# Or Resend instead (needs your own domain to email people other than yourself):
RESEND_API_KEY=
EMAIL_FROM=
# Without either, hosts are told to contact support, and the owner makes reset links on /admin.

# ---- Apple Music (optional until your Apple Developer account is ready) ----
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the whole .p8 file contents; newlines can be written as \n
APPLE_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us
# Built-in WeParty player on the host/DJ screen (needs the Apple keys above and the
# host's own Apple Music subscription). Off unless set to 1. See docs/HOST_PLAYER.md.
# FEATURE_HOST_PLAYER=1

# ---- Growth + polish (see docs/GROWTH.md) ----
# "Your night in music" recap, taste matches, "Follow this DJ" emails, "Host your own party" links.
# ON by default; set to 0 to hide them.
FEATURE_GROWTH=
# Host terms checkbox when creating an event (turn on after your lawyer reviews /terms)
FEATURE_TERMS=

# ---- Testing only. Never set this in production. ----
# WEPARTY_TEST_CATALOG=1
