# ---- Required ----
# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Any long random text (at least 32 characters). Keeps host sign-ins secure.
SESSION_SECRET=
# Your public web address, e.g. https://weparty.vercel.app (used in QR codes)
NEXT_PUBLIC_APP_URL=

# ---- Live updates (strongly recommended) ----
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Optional: only people with this code can create host accounts ----
HOST_SIGNUP_CODE=

# ---- Email for "Forgot password?" (optional but recommended; see docs/PASSWORD_RESET.md) ----
# Free account at resend.com > API Keys. Without these, reset links are written
# to Vercel > Logs instead of being emailed (only you can see those).
RESEND_API_KEY=
# Who the email comes from, e.g. We Party <noreply@yourdomain.com>
# (Until you verify a domain in Resend, use: We Party <onboarding@resend.dev>,
#  which can only send to the email you signed up to Resend with.)
EMAIL_FROM=

# ---- Apple Music (optional until your Apple Developer account is ready) ----
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the whole .p8 file contents (line breaks, \n, or just the middle part all work)
APPLE_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us
# Built-in WeParty player on the host/DJ screen ("Play the queue here"). Turns on by
# itself once the Apple keys above are set; set to 0 to hide it. See docs/HOST_PLAYER.md.
# FEATURE_HOST_PLAYER=0

# ---- Growth + polish (see docs/GROWTH.md) ----
# "Your night in music" recap, taste matches, "Follow this DJ" emails, "Host your own party" links.
# ON by default; set to 0 to hide them.
FEATURE_GROWTH=
# Host terms checkbox when creating an event (turn on after your lawyer reviews /terms)
FEATURE_TERMS=

# ---- Testing only. Never set this in production. ----
# WEPARTY_TEST_CATALOG=1
