{
  "name": "weparty",
  "version": "0.1.0",
  "private": true,
  "description": "WeParty — Where We All Control the Vibes. Powered by Offtrack.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/party-flow.mjs",
    "test:load": "node tests/load/party-load.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "app:icons": "node scripts/make-app-icons.mjs",
    "app:assets": "npx -y @capacitor/assets@4.0.0 generate --ios --android --iconBackgroundColor \"#07060c\" --iconBackgroundColorDark \"#07060c\" --splashBackgroundColor \"#07060c\" --splashBackgroundColorDark \"#07060c\"",
    "app:sync": "cap sync",
    "app:ios": "cap sync ios && cap open ios",
    "app:android": "cap sync android && cap open android",
    "test:a11y": "node tests/e2e/a11y-audit.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "jose": "^6.2.17",
    "motion": "^12.43.0",
    "next": "^15.5.29",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.10.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
